[resource]
script = ExtResource("6_xt6jo")
title = "Convoy out of Halgren"
subtitle = "Accord escort — one Lancet, one hauler"
briefing = "The Corvid is carrying reactor parts we cannot replace.
Its route runs past a Dominion picket and it has no guns.

Stay with it. It will not manoeuvre, it will not run, and it will
not survive a single unopposed pass. The first flight is already
out there; a second will jump in once you are committed.

Get the hauler to the jump point and you have done your job."
player_profile = ExtResource("5_44pk2")
player_start = Vector3(180, 60, 900)
player_facing = Vector3(0, 0, -1500)
groups = Array[ExtResource("2_3hogs")]([SubResource("Resource_ujdql"), SubResource("Resource_5q417"), SubResource("Resource_j3vrn")])
goals = Array[ExtResource("1_vsbkv")]([SubResource("Resource_hc4kn"), SubResource("Resource_eduns"), SubResource("Resource_fbv15"), SubResource("Resource_ogeno")])
time_limit = 420.0
