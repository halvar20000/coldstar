[resource]
script = ExtResource("5_5f35a")
title = "Regroup at Halgren Gate"
subtitle = "Accord defensive patrol — Lancet flight"
briefing = "The raiders you did not stop went through the Gate.
There are more of them now, and they know we are thin here.

Hold the Gate. Nothing gets past you a second time.

Your wing launches with you. Use them — a Lancet alone against
five is arithmetic, not flying."
player_profile = ExtResource("3_rsll6")
player_start = Vector3(0, 0, 1400)
player_facing = Vector3(0, 0, -2000)
groups = Array[ExtResource("2_xgnry")]([SubResource("Resource_cun41"), SubResource("Resource_es5r6"), SubResource("Resource_fjo7y")])
wing_group = "wing"
goals = Array[ExtResource("1_r5jsk")]([SubResource("Resource_u6kwr"), SubResource("Resource_6181s"), SubResource("Resource_3v1q7")])
